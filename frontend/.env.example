# Copy to frontend/.env.local for local development. These values are PUBLIC (they end up in the browser bundle).
# Never put a service-role key or a database password here.

# Supabase project URL (without /rest/v1) and the publishable key (sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave empty locally: the Vite dev server forwards /api to http://localhost:8000.
# On Render set it to the API service URL, e.g. https://buildora-api.onrender.com (no trailing slash).
VITE_API_BASE_URL=
