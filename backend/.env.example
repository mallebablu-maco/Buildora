# Copy to backend/.env for local development. Never commit real values.
# The service-role key is never used anywhere in this project.

ENVIRONMENT=development

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co  (without /rest/v1). Public value.
SUPABASE_URL=
# Public "publishable" key (sb_publishable_...). Not used for token checks; later phases use it for Storage calls.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of browser origins allowed to call the API.
# Local dev default shown; on Render set this to the website's URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SECRET. Supabase "Session pooler" connection string (Connect button -> Session pooler). It contains the database password.
# Keep it ONLY in this git-ignored file and in Render's environment settings. Never paste it into chat or commit it.
# Looks like: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If the password has special characters (@ : / ? # %), write them percent-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=
