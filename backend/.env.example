# Copy to backend/.env for local development. Never commit real values.
# Only PUBLIC values are needed in this phase; the service-role key is never used anywhere in this project.

ENVIRONMENT=development

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co  (without /rest/v1)
SUPABASE_URL=
# Public "publishable" key (sb_publishable_...). Not used for token checks yet; later phases use it for Storage calls.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of browser origins allowed to call the API.
# Local dev default shown; on Render set this to the static site's URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Added in Phase 2 (database): DATABASE_URL = the Supabase *Session pooler* connection string. It contains the database
# password: keep it only in this git-ignored file and in Render's environment settings. Never paste it into chat.
